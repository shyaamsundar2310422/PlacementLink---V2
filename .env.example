APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# Use DATABASE_URL on Render, or the individual values for local development.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=placement_db
# For providers that require a CA certificate, set DB_SSL_CA=/path/to/provider-ca.pem.
DB_SSL_CA=
DB_SSL_MODE=disabled
DB_CONNECT_TIMEOUT=10

# Leave these unset for local development; Render sets them to its persistent disk paths.
# UPLOAD_FOLDER=/var/data/uploads
# HF_HOME=/var/data/huggingface
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Ollama is optional. Configure an HTTPS-accessible hosted Ollama endpoint for production AI features.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
